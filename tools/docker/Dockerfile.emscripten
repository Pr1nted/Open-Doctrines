FROM emscripten/emsdk:3.1.73 AS builder

# Emscripten already has emcmake, emcc, etc.
# raylib will be fetched via FetchContent in CMake

WORKDIR /src
COPY . .

# Build with emcmake
RUN emcmake cmake -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_EXE_LINKER_FLAGS="-sUSE_GLFW=3 -sASYNCIFY -sTOTAL_MEMORY=256MB -sALLOW_MEMORY_GROWTH -sMAXIMUM_MEMORY=1GB" \
    -DCMAKE_CXX_FLAGS="-sUSE_GLFW=3 -sASYNCIFY" \
    -DFETCHCONTENT_FULLY_DISCONNECTED=OFF \
    && cmake --build build -- -j$(nproc)

# Package output
FROM scratch AS output
COPY --from=builder /src/build/OpenDoctrines.html /
COPY --from=builder /src/build/OpenDoctrines.js /
COPY --from=builder /src/build/OpenDoctrines.wasm /
COPY --from=builder /src/data /data/
