# CMake build files
build/
build-release/
cmake-build-*/
CMakeCache.txt
cmake_install.cmake
Makefile

# CLion-specific files
.idea/
*.iml
*.iws
*.ipr

# Executable files
*.exe
*.out
*.dSYM/

# Other
.vscode/
dist/*
AGENTS.md
.DS_Store

# Map editor projects and generated assets (user-created context, not source)
data/projects/
# Exported playthrough timelapses
data/timelapses/
# Saved games. The game writes them inside the repo, and package.py has always
# treated them as user data too private to ship; the repository had no matching
# rule, so they sat untracked and made the tree dirty enough for release.py to
# refuse to cut a release.
data/saves/
# The signed-in account's session token. The app bundle's data/ is a symlink
# to this directory, so the game writes it here -- inside the repo.
data/account.json
# The server book: where you play. Local, and yours.
data/servers.json

# Gearbox mod system: built artifacts and installed mods
build-web/
data/mods/*.odmod
data/mods.json
sdk/**/mod.wasm
sdk/**/*.odmod
sdk/**/node_modules/
sdk/**/package-lock.json

# SDK toolchains installed by tools/sdk_toolchains.sh
.toolchains/

# Second build tree, used to test the classic-interpreter build
# (-DOD_MODS_FAST_INTERP=OFF) that the Python SDK requires.
build-classic/

# Build trees belonging to tools/qualify_docker.sh. Kept between runs so a
# container run does not re-fetch WAMR and mbedTLS every time, which is what
# makes it cheap enough to actually reach for.
.docker-build/

# Python bytecode from tools/
__pycache__/
*.pyc

# Cloudflare multiplayer infrastructure (net/)
net/node_modules/
net/.wrangler/
net/package-lock.json
# The nickname blocklist is deployment data, uploaded to KV. See net/blocklist/README.md.
net/blocklist/profanity.txt
# Local development secrets. See net/.dev.vars.example.
net/.dev.vars
net/od-secrets-BACKUP.txt
net/wrangler.toml.bak

# Tunnel helper for hosting a multiplayer game. A ~37 MB platform-specific
# executable: the copy here is arm64 macOS, so it is dead weight for every
# clone on any other platform, and the web build excludes it outright because
# a browser cannot spawn a process. Fetch it per-platform instead of shipping
# one binary in history.
data/tools/cloudflared

# Four-client playtest sandbox: synthetic accounts and symlinked assets.
.playtest/
data-p2/

# Worlds made or imported locally, plus the throwaway maps --train-ai generates.
# A training run that is killed rather than closed leaves its map behind, so
# this fills up with __ai_training_<pid>__.odmap nobody wants.
data/custom_maps/

# The playtest bridge probe is BUILT, never committed. tools/playtest.sh
# compiles it against the current sdk/gearbox_generated.h on every run, because
# a stale one would silently test an ABI the host no longer has -- which is
# worse than not testing the bridge at all.
tools/playtest-mod/mod.wasm
tools/playtest-mod/bridge-check.odmod

# Throwaway install tools/screenshots.sh builds to photograph a KNOWN game
# rather than this machine's. The images it produces are committed (docs/img);
# the install it produces is not.
.screenshots/

# The developer's own settings -- and, until this was removed from history, a
# signed serverCredential that proves which multiplayer server is yours. It is
# per-machine state, not project state: Config::load() returns false when it is
# absent and every field has a default, so a fresh clone simply starts with
# them. tools/package.py already excluded it from releases; this excludes it
# from the repository too.
data/config.json

# Transient AI training artifacts.
#
# data/ai/model.bin IS tracked -- it is the trained model the game ships with.
# These are not: the per-worker copies a parallel pool trains against
# (tools/train_parallel.py), the backup that launcher takes before merging them
# back, and the scratch map directory a training round exports into. All three
# are 5-12 MB apiece and regenerate on every run.
data/ai/model.w*.bin
data/ai/model.bin.prev
data/ai/*.tmp
# Hand-made checkpoints taken before a change that cannot be undone by
# training -- resetting a module head, or altering what the reward means.
# Worth keeping on disk to roll back to, never worth committing: each is a
# 12 MB copy of a file that is already tracked.
data/ai/model.pre-*.bin
# The league's pool of past policies. Regenerated by any training run, six
# files of several megabytes each, and meaningless outside the run that wrote
# them.
data/ai/league-*.bin
data/ai/pre-reset-workers/
data/tmp_export___ai_training_*/
data/custom_maps/__ai_training_*.odmap
data/custom_maps/__ai_eval_*.odmap

# Scratch build trees. build/, build-release/, build-web/ and build-classic/
# are named above; this catches the ad-hoc ones (build-verify, build-aieval...)
# that get made to test something without disturbing a running build.
build-*/

# Generated page art. tools/banner.py rebuilds any of it in seconds, and the
# animated variants run to 13 MB apiece -- a repository is the wrong place for
# them. The two files the live page actually fetches are committed by name
# below; everything else is regenerated on demand.
docs/itch/banner-*.gif
docs/itch/banner-*eras*.png
docs/itch/banner-wide*.png
docs/itch/banner-cover*.png
docs/itch/banner-x-header*.png
docs/itch/banner-github-social*.png
docs/itch/banner-itch-wide.png
docs/itch/banner-itch-wide-plain.png
docs/itch/banner-*-plain.webp
docs/itch/banner-*eras*.webp
