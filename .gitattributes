# Krita documents are zip archives of PNG and XML. Git's heuristics would treat
# some of them as text, try to merge them line by line, and produce a file
# Krita cannot open -- so they are declared binary rather than discovered to be.
*.kra binary

# Signed fixtures are bytes, not text: a CRLF checkout on Windows changes the
# manifest after it was signed, and the updater test then sees a bad signature.
tests/fixtures/release_signing/** -text
