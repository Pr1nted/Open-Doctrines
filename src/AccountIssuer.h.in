#pragma once
// Generated by CMake from OD_ACCOUNT_ISSUER. Do not edit; edit the option.
//
// WHY A FILE AND NOT A -D.
//
// The URL used to reach the compiler as
// `-DOD_ACCOUNT_ISSUER=\"https://...\"`, which meant the value crossed CMake,
// the generator, a Makefile and a shell before the preprocessor ever saw it.
// On Linux it did not survive: the define was written correctly into
// flags.make and Config.cpp.o came out holding
// "https://opendoctrines-net.opendoctrines.workers" -- the last four
// characters gone -- so a release build pointed sign-in at a host that does
// not exist. macOS and Windows were unaffected, which is the worst version of
// such a bug: it ships on one platform and passes every check on the others.
//
// Written here instead, the string is quoted once by CMake into a file the
// compiler reads directly. Nothing splits it, nothing escapes it, and there
// is no shell in the path at all.
#define OD_ACCOUNT_ISSUER_BAKED "@OD_ACCOUNT_ISSUER@"

// The Discord application, for rich presence. Baked for the same reason and by
// the same route: config.json is not in the repository, so an id left only
// there works for whoever set it and for nobody who downloads the game. It is a
// PUBLIC identifier -- it travels in every presence payload -- so unlike a
// secret it belongs in the build.
#define OD_DISCORD_APP_ID_BAKED "@OD_DISCORD_APP_ID@"
